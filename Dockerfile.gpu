# GPU-enabled Dockerfile for AutonomyX Vision AI
# Uses CUDA for faster inference
FROM ultralytics/ultralytics:latest

# Install Tesseract OCR with English and Hindi language support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin \
    ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi uvicorn python-multipart pillow \
    opencv-python-headless pytesseract \
    rembg[gpu] \
    open-clip-torch \
    openai-whisper \
    mcp httpx

# Copy application files
COPY app.py /app/app.py
COPY auth.py /app/auth.py
COPY rate_limit.py /app/rate_limit.py
COPY metrics.py /app/metrics.py
COPY mcp_server.py /app/mcp_server.py
WORKDIR /app

# Pre-download YOLO model
RUN python3 -c "from ultralytics import YOLO; YOLO('yolo26n.pt')"

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD curl -f http://localhost:8000/health || exit 1
CMD ["python3", "app.py"]